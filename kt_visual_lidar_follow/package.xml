<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kt_visual_lidar_follow</name>
  <version>0.1.0</version>
  <description>
    Dry-run visual-lidar follow node for Tianracer KT.
    Fuses visual target detection with LaserScan distance
    association and a finite state machine for follow behavior.
    First version operates in dry-run mode only (no /cmd_vel output).
  </description>
  <maintainer email="tianbot@todo.todo">tianbot</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ai_msgs</depend>
  <depend>rclpy</depend>
  <depend>ackermann_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
